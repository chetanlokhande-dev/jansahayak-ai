# Copy this file to .env and fill in your values. Never commit .env.

# Get a key at https://aistudio.google.com/apikey
# Leave empty to run in offline mode (answers come from the built-in sample knowledge base only).
GEMINI_API_KEY=

# Model used for explanations, chat and translation
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limit in megabytes
MAX_UPLOAD_MB=10

# Tesseract language packs to use for OCR (only installed packs are used)
OCR_LANGS=eng+hin+mar

# SQLite file for conversation history (use PostgreSQL/Supabase for production)
DB_PATH=./jansahayak.db

# Requests allowed per minute per browser for AI/upload endpoints
RATE_LIMIT_PER_MINUTE=30
